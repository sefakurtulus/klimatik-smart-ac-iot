# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Weather API (Open-Meteo kullanıldığı için key gerekmez, opsiyonel)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ESP32 Local IP (Geliştirme amaçlı)
ESP_LOCAL_URL=http://192.168.1.100/api/ac

# EAS (Expo Application Services)
EAS_PROJECT_ID=your_eas_project_id
